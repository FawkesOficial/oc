#!/usr/bin/env bash
# oc - opencode sandbox manager
#
# Manages per-project Podman containers for opencode.
# Each container is isolated to one project directory via volume mount.
# Containers persist between sessions (runtime installs survive) but stop
# automatically when opencode exits.
#
# Install:
#   chmod +x ~/.local/bin/oc
#   # ensure ~/.local/bin is on your PATH

set -euo pipefail

# ── Configuration ──────────────────────────────────────────────────────────────
# Set to "true" to enable web server mode (exposes port 4096, adds --port/--hostname).
# Default is "false" - TUI-only, no port binding, allows multiple sandboxes.
ENABLE_WEB="${ENABLE_WEB:-false}"

# ── Constants ──────────────────────────────────────────────────────────────────
IMAGE="opencode-sandbox:latest"
CONFIG_DIR="${HOME}/.config/opencode"
LABEL="oc.managed=true"

# ── Helpers ────────────────────────────────────────────────────────────────────
usage() {
    cat << EOF
oc - opencode sandbox manager

Usage:
  oc [PROJECT_DIR]        Launch opencode in a sandbox for a project (default: cwd)
  oc attach|a [PROJECT_DIR] Open a bash shell in a running sandbox (default: cwd)
  oc list                 Show all managed containers and their status
  oc stop [PROJECT_DIR]   Stop a running container (default: cwd)
  oc recreate [PROJECT_DIR]  Rebuild a container from the current image
  oc clean                Remove all stopped managed containers
  oc logs [PROJECT_DIR]   Tail container logs (default: cwd)
  oc help                 Show this message

Environment:
  ENABLE_WEB=true         Enable web server mode (port 4096, --hostname/--port)
                          Default: false (TUI-only, allows multiple sandboxes)

The container name is derived from the project directory name.
Use the full path to disambiguate projects with the same folder name:
  oc ~/projects/myapp
  oc ~/work/myapp

Containers persist between sessions - packages installed at runtime (sudo apt-get install)
survive. The container stops automatically when opencode exits and restarts on next launch.
Use "oc recreate" to rebuild a container from a fresh image.
EOF
}

# Derive a stable, readable container name from an absolute path.
# Uses the last two path segments to reduce collisions: proj-myapp, work-api, etc.
container_name() {
    local dir="$1"
    local parent base
    parent="$(basename "$(dirname "$dir")")"
    base="$(basename "$dir")"
    # Strip characters Podman won't accept in names
    echo "oc-${parent}-${base}" | tr -cs 'a-zA-Z0-9_.-' '-' | sed 's/-*$//'
}

# Derive the container-side mount path from an absolute host path.
# Uses the last two path segments: /workspace/parent/base
container_path() {
    local dir="$1"
    echo "/workspace/$(basename "$(dirname "$dir")")/$(basename "$dir")"
}

require_keys() {
    if [[ -z "${GROQ_API_KEY:-}" ]]; then
        echo "error: GROQ_API_KEY is not set" >&2
        echo "  Add it to your shell profile: export GROQ_API_KEY=\"gsk_...\"" >&2
        exit 1
    fi
}

require_image() {
    if ! podman image exists "$IMAGE" 2> /dev/null; then
        echo "error: image '$IMAGE' not found." >&2
        echo "  Build it first:" >&2
        echo "    podman build --build-arg HOST_UID=\$(id -u) -t $IMAGE $HOME/programming/oc/" >&2
        exit 1
    fi
}

# ── Commands ───────────────────────────────────────────────────────────────────

cmd_launch() {
    local project_dir
    project_dir="$(realpath "${1:-$(pwd)}")"

    if [[ ! -d "$project_dir" ]]; then
        echo "error: directory not found: $project_dir" >&2
        exit 1
    fi

    require_keys
    require_image

    local name
    name="$(container_name "$project_dir")"

    local status
    status="$(podman inspect --format '{{.State.Status}}' "$name" 2> /dev/null || echo "absent")"

    case "$status" in
        running)
            # Container already running (another terminal has a session).
            # Attach opencode without --port/--hostname (TUI quirk: if an instance
            # is already listening, a second one with those flags silently skips the TUI).
            echo "→ Attaching to sandbox: $name"
            exec_opencode_attach "$name" "$project_dir"
            ;;

        exited | stopped)
            # Container exists but is stopped. Start it, run opencode, stop on exit.
            echo "→ Starting sandbox: $name"
            podman start "$name" > /dev/null
            exec_opencode "$name" "$project_dir"
            echo "→ Stopping sandbox: $name"
            podman stop --time 1 "$name" > /dev/null 2>&1
            ;;

        absent)
            # First launch. Create the container, run opencode, stop on exit.
            echo "→ Creating sandbox: $name"
            cmd_create "$name" "$project_dir"
            exec_opencode "$name" "$project_dir"
            echo "→ Stopping sandbox: $name"
            podman stop --time 1 "$name" > /dev/null 2>&1
            ;;

        *)
            echo "error: container '$name' is in unexpected state: $status" >&2
            exit 1
            ;;
    esac
}

# Create a persistent container. PID 1 is `sleep infinity` so the container
# exists as a stable unit that can be started/stopped. Opencode runs via
# `podman exec` and the container is stopped when the session ends.
cmd_create() {
    local name="$1"
    local project_dir="$2"
    local cpath
    cpath="$(container_path "$project_dir")"

    # Ensure required directories exist on the host
    mkdir -p $HOME/.local/{share,state}/{opencode,opentui}

    podman run -d \
        --name "$name" \
        --hostname "oc-$(basename "$project_dir")" \
        --label "$LABEL" \
        --userns=keep-id \
        \
        `# Filesystem: project rw, global config ro, opencode session data rw. Nothing else is visible.` \
        -v "${project_dir}:${cpath}:z,rw" \
        -v "${CONFIG_DIR}:/home/dev/.config/opencode:z,rw" \
        -v "$HOME/.local/share/opencode:/home/dev/.local/share/opencode:z,rw" \
        -v "$HOME/.local/state/opencode:/home/dev/.local/state/opencode:z,rw" \
        -v "$HOME/.local/share/opentui:/home/dev/.local/share/opentui:z,rw" \
        \
        `# GitHub CLI auth passthrough (read-only - gh never writes tokens inside the container).` \
        -v "$HOME/.config/gh:/home/dev/.config/gh:z,ro" \
        \
        `# SSH agent socket passthrough - container uses host ssh-agent for git auth.` \
        `# Only mounted when SSH_AUTH_SOCK is set (i.e. an agent is running).` \
        ${SSH_AUTH_SOCK:+-v "${SSH_AUTH_SOCK}:/ssh-agent:z,ro"} \
        -e SSH_AUTH_SOCK="${SSH_AUTH_SOCK:+/ssh-agent}" \
        \
        `# Secrets injected as env vars - never written to disk inside container.` \
        -e GROQ_API_KEY="${GROQ_API_KEY}" \
        -e OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}" \
        -e GH_TOKEN="${GH_TOKEN:-$(gh auth token)}" \
        \
        `# Terminal passthrough.` \
        -e TERM="xterm-256color" \
        \
        `# Port exposure for remote access (only when ENABLE_WEB=true).` \
        $([ "$ENABLE_WEB" = "true" ] && echo "-p 4096:4096") \
        \
        "$IMAGE" \
        sleep infinity

    # Inject host git identity into the persistent container (one-time setup).
    local git_email git_name
    git_email="$(git config --global user.email 2>/dev/null || true)"
    git_name="$(git config --global user.name 2>/dev/null || true)"
    if [[ -n "$git_email" ]]; then
        podman exec "$name" git config --global user.email "$git_email"
    fi
    if [[ -n "$git_name" ]]; then
        podman exec "$name" git config --global user.name "$git_name"
    fi
}

# Launch an interactive opencode session inside a running container.
# Used for the first launch or after a container restart - starts the server
# with --port/--hostname when ENABLE_WEB=true.
exec_opencode() {
    local name="$1"
    local project_dir="$2"
    local cpath
    cpath="$(container_path "$project_dir")"

    local web_args=""
    if [[ "$ENABLE_WEB" = "true" ]]; then
        web_args="--port 4096 --hostname 0.0.0.0"
    fi

    podman exec -it \
        -w "$cpath" \
        -e TERM="xterm-256color" \
        "$name" \
        opencode "$cpath" $web_args
}

# Attach to an already-running opencode instance.
# Omits --port/--hostname because the server is already listening;
# including them would cause opencode to skip the TUI.
exec_opencode_attach() {
    local name="$1"
    local project_dir="$2"
    local cpath
    cpath="$(container_path "$project_dir")"

    podman exec -it \
        -w "$cpath" \
        -e TERM="xterm-256color" \
        "$name" \
        opencode "$cpath"
}

cmd_list() {
    local containers
    containers="$(podman ps -a \
        --filter "label=$LABEL" \
        --format "table {{.Names}}\t{{.Status}}\t{{.CreatedAt}}" \
        2> /dev/null)"

    if [[ -z "$containers" ]] || [[ "$containers" == *"NAMES"$'\n' ]]; then
        echo "No managed sandboxes found."
        return
    fi

    echo "$containers"
}

cmd_stop() {
    local project_dir
    project_dir="$(realpath "${1:-$(pwd)}")"
    local name
    name="$(container_name "$project_dir")"

    if ! podman container exists "$name" 2> /dev/null; then
        echo "No sandbox found for: $project_dir"
        exit 1
    fi

    local status
    status="$(podman inspect --format '{{.State.Status}}' "$name")"
    if [[ "$status" != "running" ]]; then
        echo "Sandbox '$name' is not running (status: $status)"
        exit 0
    fi

    echo "→ Stopping: $name"
    podman stop --time 1 "$name" > /dev/null 2>&1
}

cmd_recreate() {
    local project_dir
    project_dir="$(realpath "${1:-$(pwd)}")"

    if [[ ! -d "$project_dir" ]]; then
        echo "error: directory not found: $project_dir" >&2
        exit 1
    fi

    require_keys
    require_image

    local name
    name="$(container_name "$project_dir")"

    echo "→ Recreating sandbox from current image: $name"
    podman rm -f "$name" > /dev/null 2>&1 || true
    cmd_create "$name" "$project_dir"
    exec_opencode "$name" "$project_dir"
}

cmd_clean() {
    local stopped
    stopped="$(podman ps -a \
        --filter "label=$LABEL" \
        --filter "status=exited" \
        --format "{{.Names}}" 2> /dev/null)"

    if [[ -z "$stopped" ]]; then
        echo "Nothing to clean."
        return
    fi

    echo "The following stopped sandboxes will be removed:"
    echo "$stopped" | while read -r name; do
        echo "  $name"
    done
    echo ""
    read -rp "Type YES to confirm: " confirm
    if [[ "$confirm" != "YES" ]]; then
        echo "Cancelled."
        return
    fi

    echo "Removing stopped sandboxes:"
    echo "$stopped" | while read -r name; do
        echo "  $name"
        podman rm "$name" > /dev/null
    done
}

cmd_logs() {
    local project_dir
    project_dir="$(realpath "${1:-$(pwd)}")"
    local name
    name="$(container_name "$project_dir")"

    if ! podman container exists "$name" 2> /dev/null; then
        echo "No sandbox found for: $project_dir"
        exit 1
    fi

    podman logs -f "$name"
}

cmd_attach() {
    local project_dir
    project_dir="$(realpath "${1:-$(pwd)}")"
    local name
    name="$(container_name "$project_dir")"

    if ! podman container exists "$name" 2> /dev/null; then
        echo "No sandbox found for: $project_dir"
        exit 1
    fi

    local status
    status="$(podman inspect --format '{{.State.Status}}' "$name" 2> /dev/null || echo "absent")"
    if [[ "$status" != "running" ]]; then
        echo "error: sandbox '$name' is not running (status: $status)" >&2
        echo "  Start it first with: oc $project_dir" >&2
        exit 1
    fi

    local cpath
    cpath="$(container_path "$project_dir")"

    echo "→ Attaching to sandbox: $name"
    podman exec -it \
        -w "$cpath" \
        -e TERM="xterm-256color" \
        "$name" \
        bash
}

# ── Dispatch ───────────────────────────────────────────────────────────────────
case "${1:-}" in
    list) cmd_list ;;
    attach | a) cmd_attach "${2:-}" ;;
    stop) cmd_stop "${2:-}" ;;
    recreate) cmd_recreate "${2:-}" ;;
    clean) cmd_clean ;;
    logs) cmd_logs "${2:-}" ;;
    help | --help | -h) usage ;;
    "" | *) cmd_launch "${1:-}" ;;
esac
